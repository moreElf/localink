# Add this to .env.local when the prototype is migrated to Next.js.
# Mapbox GL JS will use this public browser token for the interactive map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# If you choose Google Maps instead later, use this public browser key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# When this prototype is migrated to Next.js or another build-based frontend,
# move the values currently in config.js into these public environment vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
